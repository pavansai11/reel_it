# ===== ReelMagic backend configuration =====
# Copy to .env and fill in. Everything has a sane local-dev default.

# --- Core ---
ENV=local                     # local | production
APP_NAME=ReelMagic
LOG_LEVEL=INFO

# --- Database ---
# SQLite for MVP. Swap to a postgres:// URL later without code changes.
DATABASE_URL=sqlite:///./data/reelmagic.db

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0
# Run jobs inline in the web process instead of via RQ worker (handy for tests).
RUN_JOBS_INLINE=false

# --- Storage ---
# local  -> filesystem under STORAGE_LOCAL_DIR (dev)
# r2     -> Cloudflare R2 / any S3-compatible bucket (prod)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# Public base URL used to serve local files back to the browser in dev.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files

# R2 / S3 (only needed when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reelmagic
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# --- Edit brain (Claude) ---
# If unset, the pipeline falls back to a deterministic heuristic edit brain so
# the whole thing still runs end-to-end with zero API spend.
ANTHROPIC_API_KEY=
EDIT_BRAIN_MODEL=claude-sonnet-4-6
EDIT_BRAIN_MAX_TOKENS=8000

# --- Scoring backends ---
# CLIP aesthetic + zero-shot tags. "auto" uses open_clip if installed, else a
# fast OpenCV heuristic fallback. Force with "heuristic" to skip heavy models.
SCORING_BACKEND=auto          # auto | clip | heuristic
SCORING_DEVICE=cpu            # cpu | cuda

# --- Reel parameters ---
TARGET_DURATION_S=29
MIN_DURATION_S=25
MAX_DURATION_S=35

# --- Cost guardrails ---
MAX_FILES_PER_JOB=60
MAX_UPLOAD_MB=500
MAX_VIDEO_SECONDS=120
MAX_REELS_PER_SESSION_PER_DAY=10
ASSET_TTL_HOURS=48
# Global kill switch: when DAILY_SPEND_USD >= DAILY_SPEND_CEILING_USD, new jobs
# are refused. 0 disables the ceiling.
DAILY_SPEND_CEILING_USD=0
WATERMARK_TEXT=ReelMagic

# --- CORS / cookies ---
FRONTEND_ORIGIN=http://localhost:3000
# Extra allowed origins (comma-separated) + optional regex for preview domains.
CORS_EXTRA_ORIGINS=
CORS_ORIGIN_REGEX=
# For a split-domain HTTPS deploy (frontend and API on different hosts), set:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
